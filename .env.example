# ==========================================
# LLM Provider API Keys
# ==========================================
# Obtain keys from respective providers:
# - NVIDIA: https://build.nvidia.com/
#   (You can provide a single key or comma-separated keys for auto round-robin & 429 failover)
#   Example: NVIDIA_API_KEY=nvapi-key1,nvapi-key2,nvapi-key3,nvapi-key4
NVIDIA_API_KEY=
OPENAI_API_KEY=

# ==========================================
# Weights & Biases (Experiment Tracking)
# ==========================================
# Obtain key from: https://wandb.ai/authorize
# WANDB_MODE can be: online, offline, disabled
WANDB_API_KEY=
WANDB_MODE=disabled

# ==========================================
# External Solvers
# ==========================================
# Optional path to Concorde TSP solver executable
# If unset, CM-HH automatically searches system PATH
CONCORDE_EXECUTABLE=
